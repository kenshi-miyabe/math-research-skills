\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{verification}[2026/10/25 Verification targets, methods and evidence]

\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{booktabs}
\RequirePackage{fancyvrb}
\RequirePackage{hyperref}

\providecommand{\vpaperref}[1]{\texttt{\detokenize{#1}}}
\newcommand{\vtodo}{\textcolor{BrickRed}{\texttt{[TO FILL]}}}

\newcommand{\vfield}[1]{\par\medskip\noindent\textbf{#1}\par\smallskip}
% Compatibility for existing cards only; new cards use What and How.
\newcommand{\vcategory}[1]{\par\noindent\textbf{Legacy category}\quad #1\par}
\newcommand{\vwhat}[1]{\vfield{What}#1\par}
\newcommand{\vhow}[1]{\vfield{How}#1\par}
\newcommand{\vresult}[1]{\vfield{Result}#1\par}
\newcommand{\vevidence}{\vfield{Evidence}}
\newcommand{\vpaper}{%
  \vfield{Paper lines}%
  This card relies on the following lines.  Before using it, compare them
  with the current source.  If they differ, or if a definition, lemma or
  source edition listed under Dependencies has changed, re-check this card
  and the cards that depend on it.  For wording-only changes confirmed to
  preserve mathematical claims, hypotheses and dependencies, update the
  target version and verbatim quotations and record the basis in Log;
  proof re-verification is unnecessary.  Treat any uncertain impact as
  unverified. Preserve the previous evidence and result as history, and
  update the current Result and the main-theorem overview after re-checking.\par\smallskip}
\newcommand{\vstep}{\vfield{Expanded step}}
\newcommand{\vuse}{\vfield{Where the hypotheses are used}}
\newcommand{\vlocator}{\vfield{Locator}}
\newcommand{\vsource}{\vfield{Source text}}
\newcommand{\vdict}{\vfield{Notation map}}
\newcommand{\vgap}{\vfield{Gap}}
\newcommand{\vdeps}{\vfield{Dependencies}}
\newcommand{\vinterface}{\vfield{Interface check}}
\newcommand{\vtest}{\vfield{Tests}}
\newcommand{\vopen}{\vfield{Not settled}}
\newcommand{\vproblem}{\vfield{Open problems}}
\newcommand{\vlog}{\vfield{Log}}

\DefineVerbatimEnvironment{paperquote}{Verbatim}{fontsize=\small,frame=single}
\newenvironment{sourcequote}{\begin{quote}\itshape}{\end{quote}}

\newenvironment{vcard}[3]
  {\clearpage
   \begingroup\raggedright
   \section{#3}\label{card:#1}
   \noindent\textbf{Target}\par\smallskip
   \vpaperref{#2}\par}
  {\par\endgroup}
